# Model configurations for dump_estimates.py.
#
# Copy this file to models.toml and edit the paths to match your system.
# models.toml is gitignored — it must not contain system-specific paths.
#
# Each [[model]] entry maps to a production service configuration. The
# fields mirror ananke's EstimatorInputs and ServiceConfig so the estimate
# example produces the same numbers the daemon would.

[[model]]
name = "qwen3-4b-instruct"
model = "unsloth/Qwen3-4B-Instruct-2507-GGUF/Qwen3-4B-Instruct-2507-UD-Q5_K_XL.gguf"
context = 8192

[[model]]
name = "qwen3.6-35b-a3b"
model = "unsloth/Qwen3.6-35B-A3B-GGUF/Qwen3.6-35B-A3B-UD-Q5_K_XL.gguf"
mmproj = "unsloth/Qwen3.6-35B-A3B-GGUF/mmproj-F16.gguf"
context = 524288
cache_type_k = "q8_0"
cache_type_v = "q8_0"
flash_attn = true
parallel = 2
mtp = true
split_mode = "tensor"
n_cpu_moe = 40

